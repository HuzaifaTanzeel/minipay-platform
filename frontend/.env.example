# Frontend dev proxy config (server-side only; NOT shipped to the browser).
# Copy to frontend/.env for local development.

# Where the Vite dev server proxies /api requests.
API_PROXY_TARGET=http://localhost:8000

# API key injected into proxied /api requests by the Vite dev server.
# Must match API_KEY in the repo-root .env used by the backend.
API_KEY=minipay_local_key
