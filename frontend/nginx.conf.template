# Rendered by the nginx image's envsubst at container start.
# Only ${API_UPSTREAM} and ${API_KEY} are substituted (they are set in the
# environment); nginx's own $uri/$host variables are left untouched.
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Reverse-proxy the API and inject the key server-side so the browser
    # bundle never contains it.
    location /api/ {
        proxy_pass http://${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-API-Key "${API_KEY}";
    }

    # Probes and ops checks through the same Ingress as the UI (no API key).
    location = /health {
        proxy_pass http://${API_UPSTREAM};
        proxy_set_header Host $host;
    }
    location = /ready {
        proxy_pass http://${API_UPSTREAM};
        proxy_set_header Host $host;
    }

    # SPA history-mode fallback.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
