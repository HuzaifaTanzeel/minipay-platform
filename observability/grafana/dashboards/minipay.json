    {
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "postgres" },
      "description": "Same question as sql/07_processing_time_avg_p95.sql. Average of completed_at - created_at vs percentile_cont(0.95). Average understates the slow payments.",
      "fieldConfig": {
        "defaults": { "unit": "s", "decimals": 2 },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "id": 8,
      "title": "Payment processing time: average vs p95",
      "type": "table",
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "postgres" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ROUND(EXTRACT(EPOCH FROM AVG(completed_at - created_at))::numeric, 2) AS avg_seconds, ROUND(EXTRACT(EPOCH FROM percentile_cont(0.95) WITHIN GROUP (ORDER BY completed_at - created_at))::numeric, 2) AS p95_seconds FROM transactions WHERE completed_at IS NOT NULL",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "postgres" },
      "description": "PROCESSING older than 15 minutes (sql/03_stuck_processing_15m.sql).",
      "fieldConfig": {
        "defaults": { "unit": "none", "decimals": 0 },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "id": 9,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "title": "Stuck PROCESSING (> 15 minutes)",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "postgres" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*)::bigint AS stuck FROM transactions WHERE status = 'PROCESSING' AND created_at < NOW() - INTERVAL '15 minutes'",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "postgres" },
      "description": "pg_stat_statements is enabled in database/02_extensions.sql. mean_exec_time is per-statement average, not a request p95 — use the API histogram for that.",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 24 },
      "id": 10,
      "title": "Top statements by mean_exec_time",
      "type": "table",
      "targets": [
        {
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "postgres" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT LEFT(query, 120) AS query, calls, ROUND(mean_exec_time::numeric, 2) AS mean_ms, ROUND(total_exec_time::numeric, 2) AS total_ms FROM pg_stat_statements WHERE query NOT LIKE '%pg_stat_statements%' ORDER BY mean_exec_time DESC LIMIT 15",
          "refId": "A"
        }
      ]
    }
