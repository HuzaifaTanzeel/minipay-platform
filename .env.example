# Copy to .env and replace CHANGE_ME values. Never commit .env.
#   copy .env.example .env

DB_NAME=minipay
DB_USER=minipay
DB_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://minipay:CHANGE_ME@localhost:5432/minipay

API_KEY=CHANGE_ME
LOG_LEVEL=INFO
APP_PORT=8000

MINIPAY_BASE_URL=http://localhost:8000
MINIPAY_DB_DSN=postgresql://minipay:CHANGE_ME@localhost:5432/minipay
MINIPAY_API_URL=http://localhost:8000
MINIPAY_API_KEY=CHANGE_ME
MINIPAY_TIMEOUT=3

# Local pgAdmin only (docker compose --profile tools). Not used in Kubernetes.
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=CHANGE_ME
